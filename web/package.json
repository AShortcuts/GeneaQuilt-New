{
  "name": "geneaquilt-web",
  "private": true,
  "version": "0.1.0",
  "description": "The Vite browser workspace for GeneaQuilt.",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=9"
  },
  "scripts": {
    "build:wasm": "node ../scripts/build-wasm.mjs",
    "build:cloudflare": "vite build",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "test": "npm run test:typescript",
    "test:typescript": "node --import tsx --test",
    "benchmark:scale": "node --import tsx src/performance/runScaleBenchmarks.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.benchmark.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
